# ============================================================
# TrueRepublic Node Configuration
# ============================================================
# Copy this file to .env and customize for your deployment.

# Chain identity
CHAIN_ID=truerepublic-1
MONIKER=my-truerepublic-node

# Peer topology is not accepted through environment substitution. Edit the
# initialized config.toml through the reviewed change procedure, then validate
# it with `truerepublicd network-policy validate`.

# Gas
MIN_GAS_PRICE=1000upnyx

# Initial bootstrap authority (bech32 account address)
BOOTSTRAP_OPERATOR=

# Local-only P2P host port. RPC and REST are available only through the
# loopback-bound local proxy at http://127.0.0.1:8080.
P2P_PORT=26656

# Private two-source Prometheus baseline (CometBFT plus SDK/application).
# Both endpoints stay inside the node namespace; false disables both.
PROMETHEUS_ENABLED=true

# Grafana (required; choose a strong local value and never commit the real .env)
GRAFANA_PASSWORD=
