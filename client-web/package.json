{
  "name": "client-web",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/bundle-budget.mjs",
    "preview": "vite preview",
    "test": "node --test scripts/*.node-test.mjs && vitest",
    "test:browser": "playwright test",
    "test:chain": "vitest run src/services/clientChain.integration.test.ts",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "lint": "eslint .",
    "audit:high": "node scripts/audit-high.mjs"
  },
  "dependencies": {
    "@cosmjs/amino": "^0.39.0",
    "@cosmjs/crypto": "^0.39.0",
    "@cosmjs/encoding": "^0.39.0",
    "@cosmjs/proto-signing": "^0.39.0",
    "@cosmjs/stargate": "^0.39.0",
    "@headlessui/react": "^2.2.10",
    "@heroicons/react": "^2.1.1",
    "autoprefixer": "^10.5.4",
    "clsx": "^2.1.0",
    "cosmjs-types": "^0.11.0",
    "postcss": "^8.5.26",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "tailwindcss": "^4.3.3",
    "zustand": "^5.0.14"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "minimatch": "10.2.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "happy-dom": "^20.11.1",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
