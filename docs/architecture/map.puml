@startuml map-components
skinparam componentStyle rectangle

package "client-web (maintained)" {
  [client-web UI\nCreateSuggestion.tsx] as UI
  [wallet session\nwallet.ts] as Wallet
  [governance service\ngovernanceTx.ts] as GovSvc
  [module query\nmoduleQuery.ts] as Query
  [signing\nsigningClient.ts] as Signing
  [tx registry\ntxRegistry.ts] as Registry
}

package "truerepublicd" {
  [app composition\napp.go] as App
  [truedemocracy tx surface\nmsgs.go / signing.go / msg_server.go] as TxSurface
  [truedemocracy escrow\nescrow.go] as Escrow
  [truedemocracy governance state\nkeeper.go] as GovState
  [truedemocracy query\nquery_server.go] as TdQuery
  [treasury equations\ntreasury/keeper/rewards.go] as Treasury
  [x/bank (SDK)] as Bank
  [token cap\ntoken/invariant.go] as Token
  [x/crisis (SDK)] as Crisis
}

UI --> GovSvc : calculatePayToPut
GovSvc --> Query : ModuleQueryClient.query
Query --> TdQuery : abci_query PayToPut
TdQuery --> Treasury : CalcPutPrice
UI --> Wallet : getWalletForSigning
UI --> GovSvc : createSuggestion
GovSvc --> Signing : connectSigningClient
Signing --> Registry : createTxRegistry
GovSvc --> Signing : deliverMessages
Signing --> App : signAndBroadcast
App --> TxSurface : ValidateBasic / msgServer.SubmitProposal
TxSurface --> Escrow : SubmitProposalWithEscrow
Escrow --> GovState : Keeper.SubmitProposal
GovState --> Treasury : CalcPutPrice / CalcDomainCost
Escrow --> Bank : SendCoinsFromAccountToModule
Crisis --> Escrow : ValidateEscrowParity
Crisis --> Token : SupplyCapInvariant
@enduml
