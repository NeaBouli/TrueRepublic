{
  "version": "truerepublic.topology/v1",
  "chain_id": "truerepublic-qualification-1",
  "defaults": {
    "inbound": "deny",
    "outbound": "deny"
  },
  "nodes": [
    {
      "name": "seed-1",
      "role": "seed",
      "zone": "zone-a",
      "node_id": "0123456789abcdef0123456789abcdef01234561",
      "public_p2p": {
        "host": "seed-1.truerepublic.invalid",
        "port": 26656
      },
      "peers": [
        "sentry-1"
      ],
      "protects": []
    },
    {
      "name": "sentry-1",
      "role": "sentry",
      "zone": "zone-a",
      "node_id": "0123456789abcdef0123456789abcdef01234562",
      "public_p2p": {
        "host": "sentry-1.truerepublic.invalid",
        "port": 26656
      },
      "peers": [
        "seed-1",
        "sentry-2"
      ],
      "protects": [
        "validator-1"
      ]
    },
    {
      "name": "sentry-2",
      "role": "sentry",
      "zone": "zone-b",
      "node_id": "0123456789abcdef0123456789abcdef01234563",
      "public_p2p": {
        "host": "sentry-2.truerepublic.invalid",
        "port": 26656
      },
      "peers": [
        "seed-1",
        "sentry-1"
      ],
      "protects": [
        "validator-1"
      ]
    },
    {
      "name": "validator-1",
      "role": "validator",
      "zone": "zone-c",
      "node_id": "0123456789abcdef0123456789abcdef01234564",
