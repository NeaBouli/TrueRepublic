  "exercise_id": "phase-6-operations-rehearsal",
  "chain_id": "truerepublic-rehearsal-1",
  "environment": "synthetic-rehearsal",
  "defaults": {
    "secrets": "forbidden",
    "artifacts": "references-only",
    "live_actions": "forbidden",
    "source_target_concurrency": "forbidden"
