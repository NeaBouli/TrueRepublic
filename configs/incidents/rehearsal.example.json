  "roles": [
    {"name": "incident-commander", "primary": "incident-primary", "secondary": "incident-secondary"},
    {"name": "protocol-owner", "primary": "protocol-primary", "secondary": "protocol-secondary"},
    {"name": "security-owner", "primary": "security-primary", "secondary": "security-secondary"},
    {"name": "validator-operator", "primary": "validator-primary", "secondary": "validator-secondary"},
    {"name": "evidence-custodian", "primary": "evidence-primary", "secondary": "evidence-secondary"},
    {"name": "communications-owner", "primary": "communications-primary", "secondary": "communications-secondary"},
    {"name": "release-owner", "primary": "release-primary", "secondary": "release-secondary"}
