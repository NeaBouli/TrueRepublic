{
  "id": null,
  "uid": "truerepublic-blockchain",
  "title": "TrueRepublic Blockchain Operations",
  "description": "Recovery/testnet dashboard for private TrueRepublic node and application metrics.",
  "tags": ["truerepublic", "cosmos", "operations"],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "refresh": "15s",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {},
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "id": 1,
      "title": "Block Height",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "truerepublic-prometheus"},
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "truerepublic-prometheus"},
          "expr": "cometbft_consensus_height{job=\"truerepublic-node\"}",
          "instant": true,
          "legendFormat": "Consensus height",
          "range": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]},
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto",
        "wideLayout": true
      }
    },
    {
      "id": 2,
      "title": "Connected Peers",
      "type": "gauge",
      "datasource": {"type": "prometheus", "uid": "truerepublic-prometheus"},
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "truerepublic-prometheus"},
          "expr": "cometbft_p2p_peers{job=\"truerepublic-node\"} or vector(0)",
          "instant": true,
          "legendFormat": "Peers",
          "range": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "max": 20,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "yellow", "value": 2},
              {"color": "green", "value": 3}
            ]
          },
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      }
    },
    {
      "id": 3,
      "title": "Mempool Size",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "truerepublic-prometheus"},
